# Mneme 环境变量配置

# 服务
HOST=0.0.0.0
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://mneme:mneme123@localhost:5432/mneme

# 飞书应用凭证（Python 直接调飞书 API 推送卡片）
FEISHU_APP_ID=cli_xxxxxx
FEISHU_APP_SECRET=xxxxxx

# Plugin 认证 Token
MNEME_SERVICE_TOKEN=your-shared-secret

# 遗忘曲线参数
DECAY_BASE_RATE=0.5
DECAY_SENSITIVITY=1.0
PUSH_L1_THRESHOLD=0.3
PUSH_L1_DAILY_LIMIT=3
PUSH_WINDOW_START=9
PUSH_WINDOW_END=19
